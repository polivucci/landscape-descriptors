    "import sys\n",
    "MODULEPATH=\"../../\"\n",
    "sys.path.append(MODULEPATH)\n",
    "sys.path.append('../')\n",
    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from test_schwefel.schwefel_function import schwefel3D, schwefel3D_numpy\n",
    "from connectivity.connectivity import trace_connectivity, extract_connection_indices, save_descent_paths\n",
    "from connectivity.saddle_tree_calculations import saddle_tree_calculations\n",
    "from connectivity.plot_results import plot_results_with_paths_3d, plot_saddle_tree_with_function"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9190a1b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "critical_points_file = \"./critical_points_schwefel_3D.csv\"\n",
    "\n",
    "dataframe = pd.read_csv(critical_points_file)\n",
    "saddles_df = dataframe[dataframe[\"type\"] == \"saddle\"]\n",
    "minima_df = dataframe[dataframe[\"type\"] == \"minimum\"]\n",
    "func = lambda x: schwefel3D(x[0], x[1], x[2])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "bae8c261",
   "metadata": {},
   "outputs": [],
   "source": [
    "all_results, minima, dataframe, paths = trace_connectivity(\n",
    "    saddles_df, minima_df, dataframe ,func, return_paths=True\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "259a56f4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved 115 connections to results/saddle_to_minima_indices3D.csv\n",
      "Saved node order to results/tree_nodes.csv\n",
      "Saved tree edges to results/tree_connectivity.csv\n"
     ]
    }
   ],
   "source": [
    "save_descent_paths(paths)\n",
    "extract_connection_indices(all_results, dataframe)\n",
    "saddle_tree_calculations(all_results, minima, dataframe)"
   ]
  },
