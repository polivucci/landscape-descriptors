   "source": [
    "import sys\n",
    "MODULEPATH=\"../../\"\n",
    "sys.path.append(MODULEPATH)\n",
    "sys.path.append('../')\n",
    "\n",
    "from connectivity.connectivity import trace_connectivity, extract_connection_indices, save_descent_paths\n",
    "from test_schwefel.schwefel_function import schwefel2D_numpy, schwefel2D\n",
    "from connectivity.plot_results import plot_results_with_paths, plot_saddle_tree_with_function\n",
    "from connectivity.saddle_tree_calculations import saddle_tree_calculations\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e9e99cb9",
   "metadata": {},
   "outputs": [],
   "source": [
    "critical_points_file = \"./critical_points_schwefel.csv\"\n",
    "\n",
    "dataframe = pd.read_csv(critical_points_file)\n",
    "saddles_df = dataframe[dataframe[\"type\"] == \"saddle\"]\n",
    "minima_df = dataframe[dataframe[\"type\"] == \"minimum\"]\n",
    "func = lambda x: schwefel2D(x[0], x[1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "effb4a51",
   "metadata": {},
   "outputs": [],
   "source": [
    "all_results, minima, dataframe, paths = trace_connectivity(saddles_df,minima_df,dataframe,func,return_paths=True)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fbeb99c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved 22 connections to results/saddle_to_minima_indices2D.csv\n",
      "Saved node order to results/tree_nodes.csv\n",
      "Saved tree edges to results/tree_connectivity.csv\n"
     ]
    }
   ],
   "source": [
    "save_descent_paths(paths)\n",
    "extract_connection_indices(all_results, dataframe)\n",
    "saddle_tree_calculations(all_results, minima, dataframe)"
   ]
  },
